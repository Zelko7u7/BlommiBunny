spring.application.name=BloomiBack
server.port=8080
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/bloomidb}
spring.datasource.username=${DB_USERNAME:bloomiuser}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=org.postgresql.Driver
spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.jdbc.time_zone=UTC
spring.jpa.properties.hibernate.jdbc.lob.non_contextual_creation=true
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=6MB
logging.level.com.bloomibunny=INFO
jwt.secret=${JWT_SECRET}
jwt.expiration-ms=86400000
app.cors.allowed-origin=${CORS_ORIGIN:http://localhost:5173}
app.bootstrap.admin-username=${ADMIN_USERNAME:admin}
app.bootstrap.admin-password=${ADMIN_PASSWORD}
# Fotos subidas en desarrollo local. Heroku requiere almacenamiento externo.
app.media.local-directory=${PRODUCT_IMAGE_LOCAL_DIRECTORY:../.local/product-images}
app.media.local-enabled=${PRODUCT_IMAGE_LOCAL_ENABLED:true}
# Cloudinary: credenciales solo en el backend; ver docs/CLOUDINARY.md.
# En local se carga ../.local/cloudinary.properties al iniciar desde BloomiBack.
# En alojamiento configurar CLOUDINARY_ENABLED, CLOUDINARY_CLOUD_NAME,
# CLOUDINARY_API_KEY y CLOUDINARY_API_SECRET como variables del servidor.
